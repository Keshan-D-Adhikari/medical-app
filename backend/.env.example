# Copy to .env and fill in. The real .env is gitignored.

# Required. Local MongoDB, or an Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/medical_app

# Required. Use a long random value — the server refuses to start in
# production if this is shorter than 32 characters.
JWT_SECRET=replace_me_with_a_long_random_secret

PORT=8080
NODE_ENV=development

# Optional. Comma-separated browser origins allowed by CORS. Leave unset to
# allow any origin, which is fine for local development and native clients
# but must be set for a web deployment.
# CORS_ORIGIN=http://localhost:3000
